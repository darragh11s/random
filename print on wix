class PrintCustomElement extends HTMLElement {
  constructor() {
    super();
    this.attachShadow({ mode: 'open' });
    this.shadowRoot.innerHTML = `
      <style>
        /* Your print styles here */
      </style>
      <div id="container"></div>
    `;
  }

  set data(value) {
    this._data = value;
    this.renderData(value);
  }

  renderData(data) {
    const container = this.shadowRoot.getElementById('container');
    container.innerHTML = '';

    if (!Array.isArray(data)) {
      container.innerHTML = '<p>No data to display</p>';
      return;
    }

    data.forEach(item => {
      const itemDiv = document.createElement('div');
      itemDiv.innerHTML = `
        <p><strong>Location:</strong> ${item.location}</p>
        <p><strong>SOR Rejected:</strong> ${item.sorRejected}</p>
        <p><strong>Qty Rejected:</strong> ${item.qtyRejected}</p>
        <p><strong>SOR Added:</strong> ${item.sorAdded}</p>
        <p><strong>Qty Added:</strong> ${item.qtyAdded}</p>
        <p><strong>Reason:</strong> ${item.reason}</p>
        <hr>
      `;
      container.appendChild(itemDiv);
    });
  }
}

customElements.define('print-custom-element', PrintCustomElement);
